+  const buildArgs = (fn) => {
+    const src = fn.toString();
+    const m = src.match(/^[^(]*\(([^)]*)\)/);
+    if (!m || !m[1].trim()) return [hybridSnapshot, localId, serverNow, dt];
+    const rawParams = m[1].split(",").map((s) => s.trim().split("=")[0].trim());
+    if (rawParams[0].startsWith("{")) {
+      return [hybridSnapshot];
+    }
+    return rawParams.map((pName, idx) => {
+      if (/^(dt|delta|frameDt|step)$/i.test(pName)) return dt;
+      if (/^(now|serverNow|time|simTime|clock|t)$/i.test(pName)) return serverNow;
+      if (/^(local|self|my|ignore|client)/i.test(pName)) return localId;
+      if (/^(players|remotes|snapshot|state|list|entries|fighters|combatants)/i.test(pName)) return hybridSnapshot;
+      if (idx === 0) return hybridSnapshot;
