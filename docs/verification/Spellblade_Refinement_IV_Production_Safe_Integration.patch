+  }
+  // Allow any async asset instantiation promises inside RemotePlayers to settle, then step once more:
+  await new Promise((r) => setTimeout(r, 15));
+  if (typeof rp.update === "function") {
+    await rp.update(...buildArgs(rp.update));
+  }
+}
